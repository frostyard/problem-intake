# Names only. The values never go in Git, a wiki or a report.
# On TrueNAS this file is /mnt/fast/glitchtip/secrets/glitchtip.env
# (owner root, mode 0600, folder mode 0700). Brian writes it before the
# install (docs/runbook/glitchtip.md, "Install"); compose.yaml reads it with
# env_file on postgres, migrate and web. In CI, the job writes it with
# throwaway values.
# DATABASE_PASSWORD has the same value as POSTGRES_PASSWORD.
# ALLOWED_HOSTS starts with "localhost," (the web healthcheck and the scripts
# use localhost). A missing ALLOWED_HOSTS line is a fault: GlitchTip then
# allows every host ("*").
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_PASSWORD=
GLITCHTIP_DOMAIN=
ALLOWED_HOSTS=
DEFAULT_FROM_EMAIL=
