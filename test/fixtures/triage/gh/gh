#!/usr/bin/env node
// A fake `gh` for the triage tests (test/node/triage-*.test.mjs). It answers
// from a JSON state file named by FAKE_GH_STATE and appends every call to it,
// so a test can see the calls of a run. No network, no wall clock: the state
// file holds every issue, comment, release, label and compare answer, and the
// switches of a test: `searchTotalCount`, `searchIncomplete`, `searchOverlap`,
// `graphqlErrors`, `failCommentPost` and `failReopen`.
//
// Paths: `api repos/...`, `api graphql`, and `search issues`.
import { readFileSync, writeFileSync, writeSync } from "node:fs";

const statePath = process.env.FAKE_GH_STATE;
if (!statePath) {
  process.stderr.write("fake gh: FAKE_GH_STATE is not set\n");
  process.exit(64);
}

function load() {
  return JSON.parse(readFileSync(statePath, "utf8"));
}

function save(state) {
  writeFileSync(statePath, `${JSON.stringify(state, null, 2)}\n`);
}

// A large answer must reach the pipe before the process ends: a buffered
// stdout write is lost by process.exit(), so every write here is synchronous.
function writeAll(fd, text) {
  let offset = 0;
  while (offset < text.length) offset += writeSync(fd, text.slice(offset));
}

function answer(value) {
  writeAll(1, JSON.stringify(value === undefined ? null : value));
  process.exit(0);
}

function fail(status, text) {
  // The call log holds a failed call too: a test counts every request.
  save(state);
  writeAll(2, `gh: ${text} (HTTP ${status})\n`);
  process.exit(1);
}

function readStdin() {
  try {
    return readFileSync(0, "utf8");
  } catch {
    return "";
  }
}

const argv = process.argv.slice(2);
const state = load();
state.calls.push(argv);

const NOW = state.now ?? "2026-11-21T00:00:00Z";

function commentCount() {
  let total = 0;
  for (const repo of Object.values(state.repos ?? {})) {
    for (const issue of repo.issues ?? []) total += (issue.comments ?? []).length;
  }
  return total;
}

function stamp() {
  return new Date(Date.parse(NOW) + commentCount() * 1000).toISOString();
}

function repoOf(owner, name) {
  const id = `${owner}/${name}`;
  state.repos ??= {};
  state.repos[id] ??= { issues: [] };
  state.repos[id].issues ??= [];
  return state.repos[id];
}

function findIssue(repo, number) {
  return (repo.issues ?? []).find((issue) => issue.number === number) ?? null;
}

// The comments of 1 issue: the last 100 (or the 100 before `before`). The
// cursor is the index of the first comment of the page.
function commentPage(issue, before = null, limit = 100) {
  const all = issue.comments ?? [];
  let end = all.length;
  if (before !== null && before !== undefined) end = Math.max(0, Math.min(all.length, Number(before)));
  const start = Math.max(0, end - limit);
  return {
    pageInfo: { hasPreviousPage: start > 0, startCursor: String(start) },
    nodes: all.slice(start, end).map((comment) => ({
      author: { login: comment.author ?? "frostyard-machines" },
      authorAssociation: comment.association ?? "MEMBER",
      body: comment.body ?? "",
      createdAt: comment.createdAt ?? NOW,
    })),
  };
}

function graphqlIssue(issue, id) {
  return {
    number: issue.number,
    state: issue.state === "open" || issue.state === undefined ? "OPEN" : "CLOSED",
    stateReason: issue.stateReason ?? null,
    url: `https://github.com/${id}/issues/${issue.number}`,
    repository: { nameWithOwner: id },
    author: { login: issue.author ?? "frostyard-machines" },
    body: issue.body ?? "",
    labels: { nodes: (issue.labels ?? []).map((name) => ({ name })) },
    comments: commentPage(issue),
    timelineItems: {
      nodes:
        issue.closedAt === undefined || issue.closedAt === null
          ? []
          : [
              {
                createdAt: issue.closedAt,
                closer:
                  issue.closer === undefined || issue.closer === null
                    ? null
                    : issue.closer.type === "PullRequest"
                      ? { __typename: "PullRequest", mergeCommit: { oid: issue.closer.sha } }
                      : { __typename: "Commit", oid: issue.closer.sha },
              },
            ],
    },
  };
}

function publicIssue(id, issue) {
  return {
    number: issue.number,
    title: issue.title ?? "",
    body: issue.body ?? "",
    state: issue.state ?? "open",
    labels: (issue.labels ?? []).map((name) => ({ name })),
    repository: { nameWithOwner: id },
    author: { login: issue.author ?? "frostyard-machines" },
  };
}

function searchIssues() {
  const query = argv[2] ?? "";
  const wanted = /Problem key: ([0-9a-f]{16})/.exec(query);
  const hits = [];
  // The command filters by --author, --label and --owner: only a record of
  // this job can be a hit.
  for (const [id, repo] of Object.entries(state.repos ?? {})) {
    for (const issue of repo.issues ?? []) {
      if ((issue.author ?? "frostyard-machines") !== "frostyard-machines") continue;
      if (!(issue.labels ?? ["problem-report"]).includes("problem-report")) continue;
      const body = issue.body ?? "";
      if (wanted === null) {
        if (!/Problem key: [0-9a-f]{16}/.test(body)) continue;
      } else if (!body.includes(`Problem key: ${wanted[1]}`)) continue;
      hits.push({
        repository: { nameWithOwner: id },
        number: issue.number,
        title: issue.title ?? "",
        body,
        state: issue.state ?? "open",
      });
    }
  }
  // `--limit n` caps the answer, as GitHub does.
  const at = argv.indexOf("--limit");
  const limit = at >= 0 ? Number(argv[at + 1]) : 30;
  save(state);
  answer(hits.slice(0, Number.isSafeInteger(limit) && limit > 0 ? limit : 30));
}

if (argv[0] === "search" && argv[1] === "issues") searchIssues();

if (argv[0] !== "api") fail(404, "Not Found");

let at = 1;
const path = argv[at];

at += 1;
let method = "GET";
let input = null;
const fields = [];
for (; at < argv.length; at += 1) {
  const arg = argv[at];
  if (arg === "--method" || arg === "-X") {
    method = argv[at + 1];
    at += 1;
  } else if (arg === "--input") {
    const value = argv[at + 1];
    at += 1;
    if (value === "-") input = JSON.parse(readStdin() || "null");
    else input = JSON.parse(readFileSync(value, "utf8"));
  } else if (arg === "-f" || arg === "-F" || arg === "--field" || arg === "--raw-field") {
    fields.push(argv[at + 1]);
    at += 1;
  }
}

if (path === "graphql") {
  const variables = {};
  for (const field of fields) {
    const at2 = field.indexOf("=");
    variables[field.slice(0, at2)] = field.slice(at2 + 1);
  }
  const id = `${variables.owner}/${variables.name}`;
  const repo = (state.repos ?? {})[id] ?? { issues: [] };
  const repository = {};
  const errors = [];
  const earlier = String(variables.query).includes("before: $before");
  for (const match of String(variables.query).matchAll(/i([0-9]+): issue\(number: ([0-9]+)\)/g)) {
    const number = Number(match[2]);
    const issue = findIssue(repo, number);
    repository[`i${number}`] =
      issue === null ? null : earlier ? { comments: commentPage(issue, variables.before ?? null) } : graphqlIssue(issue, id);
    // A deleted or transferred issue: a null alias and a NOT_FOUND error, as
    // GitHub answers it.
    if (issue === null) {
      errors.push({
        type: "NOT_FOUND",
        path: ["repository", `i${number}`],
        message: "Could not resolve to a node with the global id.",
      });
    }
  }
  // `graphqlErrors` adds 1 error of another type, for the refusal test.
  if (Array.isArray(state.graphqlErrors)) errors.push(...state.graphqlErrors);
  save(state);
  if (errors.length === 0) answer({ data: { repository } });
  // `gh` prints the JSON on stdout and exits 1 when the answer holds errors.
  save(state);
  writeAll(1, JSON.stringify({ data: { repository }, errors }));
  writeAll(2, "gh: Could not resolve to an Issue\n");
  process.exit(1);
}

// search/issues: the paged API of the rebuild, 1 page for each request.
if (path === "search/issues") {
  const field = (name) => {
    const hit = fields.find((item) => item.startsWith(`${name}=`));
    return hit === undefined ? null : hit.slice(name.length + 1);
  };
  const perPage = Number(field("per_page") ?? "30");
  const page = Number(field("page") ?? "1");
  const wanted = /Problem key: ([0-9a-f]{16})/.exec(field("q") ?? "");
  const hits = [];
  for (const [id, repo] of Object.entries(state.repos ?? {})) {
    for (const issue of repo.issues ?? []) {
      if ((issue.author ?? "frostyard-machines") !== "frostyard-machines") continue;
      if (!(issue.labels ?? ["problem-report"]).includes("problem-report")) continue;
      const body = issue.body ?? "";
      if (wanted === null) {
        if (!/Problem key: [0-9a-f]{16}/.test(body)) continue;
      } else if (!body.includes(`Problem key: ${wanted[1]}`)) continue;
      // The real REST shape of a search hit.
      hits.push({
        repository_url: `https://api.github.com/repos/${id}`,
        number: issue.number,
        title: issue.title ?? "",
        body,
        state: issue.state ?? "open",
        user: { login: issue.author ?? "frostyard-machines" },
        labels: (issue.labels ?? []).map((name) => ({ name })),
      });
    }
  }
  const size = Number.isSafeInteger(perPage) && perPage > 0 ? perPage : 30;
  // `searchOverlap` repeats the last item of the page before, for the identity
  // test of the rebuild.
  const start = Math.max(0, (page - 1) * size - (state.searchOverlap === true && page > 1 ? 1 : 0));
  save(state);
  answer({
    total_count: Number.isSafeInteger(state.searchTotalCount) ? state.searchTotalCount : hits.length,
    incomplete_results: state.searchIncomplete === true,
    items: hits.slice(start, start + size),
  });
}

const [pathname, search] = path.split("?");
const params = new URLSearchParams(search ?? "");
const parts = pathname.replace(/^\/+|\/+$/g, "").split("/");

// repos/<owner>/<name>/...
if (parts[0] !== "repos" || parts.length < 4) fail(404, "Not Found");
const owner = parts[1];
const name = parts[2];
const id = `${owner}/${name}`;
const rest = parts.slice(3);

if (rest.length === 1 && rest[0] === "issues") {
  if (method === "GET") {
    const repo = (state.repos ?? {})[id] ?? { issues: [] };
    const wantedState = params.get("state");
    const wantedLabel = params.get("labels");
    const creator = params.get("creator");
    const issues = (repo.issues ?? []).filter((issue) => {
      if (wantedState !== null && (issue.state ?? "open") !== wantedState) return false;
      if (wantedLabel !== null && !(issue.labels ?? []).includes(wantedLabel)) return false;
      if (creator !== null && (issue.author ?? "frostyard-machines") !== creator) return false;
      return true;
    });
    save(state);
    answer(issues.map((issue) => publicIssue(id, issue)));
  }
  if (method === "POST") {
    const repo = repoOf(owner, name);
    const number = repo.issues.reduce((top, issue) => Math.max(top, issue.number), 0) + 1;
    const issue = {
      number,
      title: input?.title ?? "",
      body: input?.body ?? "",
      author: "frostyard-machines",
      labels: input?.labels ?? [],
      state: "open",
      stateReason: null,
      closedAt: null,
      closer: null,
      comments: [],
    };
    repo.issues.push(issue);
    save(state);
    answer(publicIssue(id, issue));
  }
  fail(404, "Not Found");
}

if (rest[0] === "labels" && rest.length === 2) {
  const labels = (state.labels ?? {})[id] ?? [];
  if (!labels.includes(rest[1])) fail(404, "Not Found");
  save(state);
  answer({ name: rest[1] });
}

if (rest[0] === "releases" && rest.length === 1) {
  const all = (state.repos ?? {})[id]?.releases ?? [];
  const perPage = Number(params.get("per_page") ?? "30");
  const page = Number(params.get("page") ?? "1");
  save(state);
  answer(all.slice((page - 1) * perPage, page * perPage));
}

if (rest[0] === "compare" && rest.length === 2) {
  const compare = (state.repos ?? {})[id]?.compare ?? {};
  if (!Object.hasOwn(compare, rest[1])) fail(404, "Not Found");
  save(state);
  answer({ status: compare[rest[1]] });
}

if (rest[0] === "issues" && rest.length >= 2) {
  const repo = (state.repos ?? {})[id] ?? { issues: [] };
  const issue = findIssue(repo, Number(rest[1]));
  if (issue === null) fail(404, "Not Found");
  if (rest.length === 2) {
    if (method === "PATCH") {
      // `failReopen: n` fails the next n PATCHes with HTTP 500.
      if ((state.failReopen ?? 0) > 0) {
        state.failReopen -= 1;
        save(state);
        fail(500, "Server Error");
      }
      if (input?.state !== undefined) issue.state = input.state;
      if (input?.body !== undefined) issue.body = input.body;
      save(state);
      answer(publicIssue(id, issue));
    }
    save(state);
    answer(publicIssue(id, issue));
  }
  if (rest.length === 3 && rest[2] === "comments") {
    issue.comments ??= [];
    if (method === "POST") {
      // `failCommentPost: n` fails the next n comment POSTs with HTTP 500.
      if ((state.failCommentPost ?? 0) > 0) {
        state.failCommentPost -= 1;
        save(state);
        fail(500, "Server Error");
      }
      const comment = {
        author: "frostyard-machines",
        association: "MEMBER",
        body: input?.body ?? "",
        createdAt: stamp(),
      };
      issue.comments.push(comment);
      save(state);
      answer({ id: issue.comments.length, body: comment.body });
    }
    // `since` keeps the comments of that instant on, and the list is paged
    // oldest first, as GitHub answers it.
    const since = params.get("since");
    const matching = issue.comments.filter(
      (comment) => since === null || Date.parse(comment.createdAt ?? NOW) >= Date.parse(since),
    );
    const perPage = Number(params.get("per_page") ?? "30");
    const page = Number(params.get("page") ?? "1");
    const size = Number.isSafeInteger(perPage) && perPage > 0 ? perPage : 30;
    save(state);
    answer(
      matching.slice((page - 1) * size, page * size).map((comment) => ({
        author: { login: comment.author ?? "frostyard-machines" },
        authorAssociation: comment.association ?? "MEMBER",
        body: comment.body ?? "",
        createdAt: comment.createdAt ?? NOW,
      })),
    );
  }
}

fail(404, "Not Found");
